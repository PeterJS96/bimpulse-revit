<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BIMPulse Dashboard" Width="1320" Height="840" MinWidth="1040" MinHeight="620"
        WindowStartupLocation="CenterScreen" Background="#050B14" Foreground="#E6EEF7"
        FontFamily="Segoe UI" FontSize="13" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <Window.Resources>
<!--BIMPULSE:STYLES-->
    </Window.Resources>

    <Grid x:Name="rootGrid">
    <Grid Margin="20,16,20,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="38" Height="38" CornerRadius="10" Background="#00A0E3" Margin="0,0,12,0">
                    <Path Data="M2,12 L6,12 L8.5,5 L12,19 L15,9 L17,12 L22,12" Stroke="#03101C" StrokeThickness="2.2"
                          StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Stretch="Uniform" Margin="8"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource Label}" Text="BIMPULSE · AUDIT ISSUES"/>
                    <TextBlock x:Name="txtProject" Text="BIMPulse Dashboard" FontSize="20" FontWeight="Bold"/>
                </StackPanel>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="btnBrowse" Style="{StaticResource Primary}" Content="Browse BIMPulse" Margin="0,0,8,0"
                        ToolTip="Open your projects' saved audits from BIMPulse"/>
                <Button x:Name="btnReload" Content="Reload" Margin="0,0,8,0" ToolTip="Fetch the latest issues and statuses from BIMPulse"/>
                <Button x:Name="btnCheck" Content="Check against model" Margin="0,0,14,0"
                        ToolTip="Look up every issue's elements in this model (and its links)"/>
                <Button x:Name="btnAccount" Style="{StaticResource Ghost}" Padding="6,4" Margin="0,0,6,0">
                    <StackPanel Orientation="Horizontal">
                        <Border x:Name="bdAvatar" Width="26" Height="26" CornerRadius="13" Background="#14304D">
                            <TextBlock x:Name="txtAvatar" Text="?" FontWeight="Bold" Foreground="#00A0E3"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock x:Name="txtAccount" Text="Sign in" Margin="8,0,4,0" VerticalAlignment="Center" MaxWidth="180"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </Button>
                <Button x:Name="btnMenu" Style="{StaticResource Ghost}" Content="&#x22EF;" FontSize="16" Padding="10,2"
                        ToolTip="Theme, docking, error reports, updates and the tour"/>
            </StackPanel>
        </Grid>

        <!-- A new version of the plugin -->
        <Border x:Name="bdUpdate" Grid.Row="1" Margin="0,0,0,12" Padding="14,9" CornerRadius="10" Background="#14304D"
                BorderBrush="#00A0E3" BorderThickness="1" Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="txtUpdate" VerticalAlignment="Center" TextWrapping="Wrap"
                           Text="A new version of the BIMPulse tools for Revit is available."/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="12,0,0,0">
                    <Button x:Name="btnUpdateNow" Style="{StaticResource Primary}" Content="Update now" Padding="12,5" Margin="0,0,8,0"/>
                    <Button x:Name="btnUpdateLater" Style="{StaticResource Ghost}" Content="Later" Padding="10,5"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Stats -->
        <Grid Grid.Row="2" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="1.9*"/>
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource Card}" Padding="16,12" Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Style="{StaticResource Label}" Text="ISSUES"/>
                    <TextBlock x:Name="statTotal" Text="0" FontSize="28" FontWeight="Bold" Margin="0,2,0,0"/>
                    <TextBlock x:Name="statFiles" Text="No results open" Foreground="#8A9BB3" FontSize="11.5"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="1" Style="{StaticResource Card}" Padding="16,12" Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Style="{StaticResource Label}" Text="OPEN"/>
                    <TextBlock x:Name="statOpen" Text="0" FontSize="28" FontWeight="Bold" Foreground="#F59E0B" Margin="0,2,0,0"/>
                    <TextBlock x:Name="statCritical" Text="0 critical or high" Foreground="#8A9BB3" FontSize="11.5"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="16,12" Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Style="{StaticResource Label}" Text="RESOLVED"/>
                    <TextBlock x:Name="statResolved" Text="0%" FontSize="28" FontWeight="Bold" Foreground="#22C55E" Margin="0,2,0,0"/>
                    <Grid Height="5" Margin="0,6,0,0">
                        <Border Background="#16243A" CornerRadius="3"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition x:Name="colResolved" Width="0*"/>
                                <ColumnDefinition x:Name="colUnresolved" Width="1*"/>
                            </Grid.ColumnDefinitions>
                            <Border Background="#22C55E" CornerRadius="3"/>
                        </Grid>
                    </Grid>
                </StackPanel>
            </Border>
            <Border Grid.Column="3" Style="{StaticResource Card}" Padding="16,12" Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Style="{StaticResource Label}" Text="FOUND IN MODEL"/>
                    <TextBlock x:Name="statFound" Text="–" FontSize="28" FontWeight="Bold" Foreground="#00A0E3" Margin="0,2,0,0"/>
                    <TextBlock x:Name="statFoundSub" Text="Run “Check against model”" Foreground="#8A9BB3" FontSize="11.5"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="4" Style="{StaticResource Card}" Padding="16,12">
                <StackPanel>
                    <Grid>
                        <TextBlock Style="{StaticResource Label}" Text="OPEN ISSUES"/>
                        <StackPanel x:Name="spSeverityKey" Orientation="Horizontal" HorizontalAlignment="Right"/>
                    </Grid>
                    <Grid x:Name="gridSeverity" Height="8" Margin="0,8,0,8"/>
                    <WrapPanel x:Name="wpAudits" ToolTip="Click an audit to show only its issues"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Body -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="430" MinWidth="340"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Issue list -->
            <Border x:Name="cardList" Style="{StaticResource Card}" Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBox x:Name="tbSearch" ToolTip="Search titles, fields, families, types, element ids"/>
                    <TextBlock x:Name="tbSearchHint" Text="Search issues, fields, families, element ids…" Foreground="#5D6F88"
                               IsHitTestVisible="False" Margin="10,0,0,0" VerticalAlignment="Center"/>
                    <Grid Grid.Row="1" Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="6"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <ComboBox x:Name="cbConsultant"/>
                        <ComboBox x:Name="cbSeverity" Grid.Column="2"/>
                    </Grid>
                    <Grid Grid.Row="2" Margin="0,6,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="6"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <ComboBox x:Name="cbReview"/>
                        <ComboBox x:Name="cbSort" Grid.Column="2"/>
                    </Grid>
                    <Grid Grid.Row="3">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid Margin="0,0,0,6">
                            <TextBlock x:Name="txtCount" Style="{StaticResource Label}" Text="0 ISSUES"/>
                            <TextBlock x:Name="btnClearFilters" Text="Clear filters" Foreground="#00A0E3" FontSize="11.5"
                                       HorizontalAlignment="Right" Cursor="Hand"/>
                        </Grid>
                        <ListBox x:Name="lbIssues" Grid.Row="1" Background="Transparent" BorderThickness="0" SelectionMode="Extended"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingStackPanel.IsVirtualizing="True"
                                 VirtualizingStackPanel.VirtualizationMode="Recycling"/>
                        <StackPanel x:Name="pnlNoFiles" Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="20">
                            <TextBlock Text="No issues loaded" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                            <TextBlock TextWrapping="Wrap" TextAlignment="Center" Foreground="#8A9BB3" Margin="0,6,0,0" MaxWidth="300"
                                       Text="Click Browse BIMPulse to open a saved audit's issues."/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <!-- Detail -->
            <Border x:Name="cardDetail" Grid.Column="2" Style="{StaticResource Card}">
                <Grid>
                    <StackPanel x:Name="pnlEmpty" VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="Select an issue" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                        <TextBlock Text="Its details, snapshot and elements show here." Foreground="#8A9BB3" Margin="0,6,0,0"/>
                    </StackPanel>
                    <Grid x:Name="pnlDetail" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="22,18,16,10">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Border x:Name="bdSeverity" CornerRadius="10" Padding="9,3" Margin="0,0,6,0">
                                        <TextBlock x:Name="txtSeverity" FontFamily="{StaticResource Mono}" FontSize="10.5" FontWeight="Bold"/>
                                    </Border>
                                    <Border x:Name="bdReview" CornerRadius="10" Padding="9,3" Margin="0,0,6,0">
                                        <TextBlock x:Name="txtReview" FontFamily="{StaticResource Mono}" FontSize="10.5" FontWeight="Bold"/>
                                    </Border>
                                    <TextBlock x:Name="txtMeta" Style="{StaticResource Label}" VerticalAlignment="Center" Margin="4,0,0,0"/>
                                </StackPanel>
                                <TextBlock x:Name="txtTitle" FontSize="19" FontWeight="Bold" TextWrapping="Wrap" Margin="0,10,0,0"/>
                                <TextBlock x:Name="txtSub" Foreground="#8A9BB3" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                <TextBlock x:Name="txtDescription" TextWrapping="Wrap" Margin="0,12,0,0" Foreground="#C9D6E6"
                                           LineHeight="19"/>

                                <Grid Margin="0,16,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,16,0">
                                        <TextBlock Style="{StaticResource Label}" Text="WHAT FAILED"/>
                                        <StackPanel x:Name="spFailures" Margin="0,6,0,0"/>
                                        <Border x:Name="pnlFix" Margin="0,12,0,0" Visibility="Collapsed" BorderBrush="#00A0E3"
                                                BorderThickness="3,0,0,0" Padding="12,2,0,2">
                                            <StackPanel>
                                                <TextBlock Text="Fix it in the model" Foreground="#00A0E3" FontSize="15" FontWeight="Bold"/>
                                                <TextBlock Foreground="#8A9BB3" FontSize="11.5" TextWrapping="Wrap" Margin="0,3,0,8"
                                                           Text="Sets the value on this issue's elements in the open model (one undoable change)."/>
                                                <StackPanel x:Name="spFix"/>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                    <Border x:Name="bdSnapshot" Grid.Column="1" CornerRadius="10" BorderBrush="#1C2B40" BorderThickness="1"
                                            Background="#081221" Width="300" Height="200" ClipToBounds="True" Visibility="Collapsed" Cursor="Hand"
                                            ToolTip="Click to open full size">
                                        <Image x:Name="imgSnapshot" Stretch="UniformToFill"/>
                                    </Border>
                                </Grid>

                                <Grid Margin="0,18,0,6">
                                    <TextBlock x:Name="txtElementsLabel" Style="{StaticResource Label}" Text="ELEMENTS"/>
                                    <TextBlock x:Name="txtModelCheck" FontSize="11.5" HorizontalAlignment="Right"/>
                                </Grid>
                                <StackPanel x:Name="spElements"/>

                                <StackPanel x:Name="pnlComments" Margin="0,14,0,0" Visibility="Collapsed">
                                    <TextBlock Style="{StaticResource Label}" Text="COMMENTS IN THE BCF"/>
                                    <StackPanel x:Name="spComments" Margin="0,6,0,0"/>
                                </StackPanel>

                                <StackPanel x:Name="pnlAssign" Margin="0,16,0,0" Visibility="Collapsed">
                                    <TextBlock Style="{StaticResource Label}" Text="ASSIGNED TO"/>
                                    <Grid Margin="0,6,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <ComboBox x:Name="cbAssignee" ToolTip="Who should fix it"/>
                                        <DatePicker x:Name="dpDue" Grid.Column="1" Width="140" Margin="8,0,0,0" ToolTip="Due date"
                                                    SelectedDateFormat="Short"/>
                                        <Button x:Name="btnAssign" Grid.Column="2" Content="Save" Margin="8,0,0,0" Padding="14,5"/>
                                    </Grid>
                                    <TextBlock x:Name="txtAssign" Foreground="#8A9BB3" FontSize="11.5" Margin="0,5,0,0" TextWrapping="Wrap"/>
                                </StackPanel>

                                <StackPanel x:Name="pnlThread" Margin="0,16,0,0" Visibility="Collapsed">
                                    <Grid>
                                        <TextBlock Style="{StaticResource Label}" Text="CONVERSATION · LIVE WITH BIMPULSE"/>
                                        <TextBlock x:Name="txtThreadState" Foreground="#5D6F88" FontSize="11" HorizontalAlignment="Right"/>
                                    </Grid>
                                    <StackPanel x:Name="spThread" Margin="0,6,0,0"/>
                                </StackPanel>

                                <TextBlock x:Name="lblNote" Style="{StaticResource Label}" Text="YOUR NOTE" Margin="0,16,0,6"/>
                                <TextBox x:Name="tbNote" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="56" MaxHeight="120"
                                         VerticalScrollBarVisibility="Auto"/>
                                <Grid Margin="0,6,0,0">
                                    <TextBlock x:Name="txtReviewedBy" Foreground="#5D6F88" FontSize="11.5" VerticalAlignment="Center"
                                               TextWrapping="Wrap" Margin="0,0,210,0"/>
                                    <CheckBox x:Name="chkSnapshot" Content="Attach this view" HorizontalAlignment="Right"
                                              VerticalAlignment="Center" Margin="0,0,86,0" Visibility="Collapsed"
                                              ToolTip="Send a picture of the active Revit view and the view itself, so anyone can go straight back to it"/>
                                    <Button x:Name="btnSend" Style="{StaticResource Primary}" Content="Send" HorizontalAlignment="Right"
                                            Padding="16,5" Visibility="Collapsed" ToolTip="Send to BIMPulse (Ctrl+Enter)"/>
                                </Grid>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- Actions -->
                        <Border Grid.Row="1" BorderBrush="#1C2B40" BorderThickness="0,1,0,0" Padding="18,12">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <WrapPanel>
                                    <Button x:Name="btnZoom" Style="{StaticResource Primary}" Content="Select &amp; zoom" Margin="0,0,8,6"/>
                                    <Button x:Name="btn3D" Content="Show in 3D" Margin="0,0,8,6"
                                            ToolTip="Opens the 'BIMPulse Issues 3D' view with a section box around the elements"/>
                                    <Button x:Name="btnIsolate" Content="Isolate" Margin="0,0,8,6" ToolTip="Temporarily isolate in the active view"/>
                                    <Button x:Name="btnSelect" Content="Select only" Margin="0,0,8,6"/>
                                    <Button x:Name="btnProps" Content="Copy ids" Margin="0,0,8,6" ToolTip="Copy the element ids to the clipboard"/>
                                </WrapPanel>
                                <Grid Grid.Row="1" Margin="0,4,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal">
                                        <Button x:Name="btnResolve" Content="Mark resolved" Margin="0,0,8,0" Foreground="#22C55E"/>
                                        <Button x:Name="btnIgnore" Content="Ignore" Margin="0,0,8,0"/>
                                        <Button x:Name="btnReopen" Content="Reopen" Margin="0,0,8,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <CheckBox x:Name="chkAuto" Content="Zoom as I browse" IsChecked="False" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                        <Button x:Name="btnPrev" Style="{StaticResource Ghost}" Content="‹ Prev" Margin="0,0,6,0" ToolTip="Previous issue (Ctrl+Up)"/>
                                        <Button x:Name="btnNext" Style="{StaticResource Ghost}" Content="Next ›" ToolTip="Next issue (Ctrl+Down)"/>
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- BIMPulse browser (over the dashboard) -->
        <Grid x:Name="pnlBrowse" Grid.Row="2" Grid.RowSpan="2" Background="#050B14" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="360"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource Card}" Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Margin="0,0,0,10">
                        <TextBlock Style="{StaticResource Label}" Text="YOUR PROJECTS" VerticalAlignment="Center"/>
                        <TextBlock x:Name="txtOrg" Foreground="#8A9BB3" FontSize="11.5" HorizontalAlignment="Right"
                                   TextTrimming="CharacterEllipsis" MaxWidth="200"/>
                    </Grid>
                    <Grid Grid.Row="1" Margin="0,0,0,10">
                        <TextBox x:Name="tbProjectSearch"/>
                        <TextBlock x:Name="tbProjectHint" Text="Search projects…" Foreground="#5D6F88" IsHitTestVisible="False"
                                   Margin="10,0,0,0" VerticalAlignment="Center"/>
                    </Grid>
                    <ListBox x:Name="lbProjects" Grid.Row="2" Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
                </Grid>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="22,18">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Style="{StaticResource Label}" Text="SAVED AUDIT"/>
                            <TextBlock x:Name="txtBrowseProject" Text="Choose a project" FontSize="19" FontWeight="Bold" Margin="0,2,0,0"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <ComboBox x:Name="cbRevision" Grid.Column="1" Width="300" VerticalAlignment="Bottom"/>
                    </Grid>
                    <Grid Grid.Row="1" Margin="0,16,0,8">
                        <TextBlock Style="{StaticResource Label}" Text="RESULTS · TICK THE ONES TO OPEN"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <TextBlock x:Name="btnSelectAll" Text="Select all" Foreground="#00A0E3" FontSize="11.5" Cursor="Hand" Margin="0,0,14,0"/>
                            <TextBlock x:Name="btnSelectNone" Text="None" Foreground="#00A0E3" FontSize="11.5" Cursor="Hand"/>
                        </StackPanel>
                    </Grid>
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="spResults"/>
                    </ScrollViewer>
                    <Grid Grid.Row="3" Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="txtBrowseNote" Foreground="#8A9BB3" FontSize="11.5" TextWrapping="Wrap" VerticalAlignment="Center"
                                   Margin="0,0,12,0"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button x:Name="btnBrowseClose" Content="Back to issues" Margin="0,0,8,0"/>
                            <Button x:Name="btnBrowseOpen" Style="{StaticResource Primary}" Content="Open issues"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- Status bar -->
        <Grid Grid.Row="4" Margin="2,10,2,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="txtStatus" Foreground="#8A9BB3" FontSize="11.5" TextTrimming="CharacterEllipsis"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button x:Name="btnColour" Style="{StaticResource Ghost}" Content="Colour issues in view" Margin="0,0,6,0"
                        ToolTip="Colour every open issue's elements in the active view by severity"/>
                <Button x:Name="btnClear" Style="{StaticResource Ghost}" Content="Clear colours &amp; isolation"/>
            </StackPanel>
        </Grid>
    </Grid>

    <!-- First-run tour: dims everything but the spotlit control -->
    <Grid x:Name="pnlTour" Visibility="Collapsed">
        <Path x:Name="pathTourDim" Fill="#B3020610"/>
        <Border x:Name="bdTourRing" BorderBrush="#00A0E3" BorderThickness="2" CornerRadius="10" HorizontalAlignment="Left"
                VerticalAlignment="Top" IsHitTestVisible="False"/>
        <Border x:Name="bdTourCard" Style="{StaticResource Card}" Width="340" Padding="18,14" HorizontalAlignment="Left"
                VerticalAlignment="Top" BorderBrush="#00A0E3">
            <StackPanel>
                <TextBlock x:Name="txtTourStep" Style="{StaticResource Label}" Text="1 OF 6"/>
                <TextBlock x:Name="txtTourTitle" FontSize="16" FontWeight="Bold" Margin="0,4,0,0" TextWrapping="Wrap"/>
                <TextBlock x:Name="txtTourBody" Foreground="#C9D6E6" Margin="0,6,0,0" TextWrapping="Wrap" LineHeight="19"/>
                <Grid Margin="0,14,0,0">
                    <Button x:Name="btnTourSkip" Style="{StaticResource Ghost}" Content="Skip tour" HorizontalAlignment="Left"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="btnTourBack" Content="Back" Margin="0,0,8,0" Padding="12,5"/>
                        <Button x:Name="btnTourNext" Style="{StaticResource Primary}" Content="Next" Padding="14,5"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
    </Grid>
</Window>
