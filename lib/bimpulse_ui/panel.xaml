<Page xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="BIMPulse" Background="#050B14" Foreground="#E6EEF7" FontFamily="BIMPULSE:FONT" FontSize="12.5"
      UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <!-- The BIMPulse Dashboard docked beside the model: the window's controls (window.xaml), stacked for a
         narrow panel. The same code drives both (bimpulse_dashboard.Dashboard). -->
    <Page.Resources>
<!--BIMPULSE:STYLES-->
    </Page.Resources>

    <Grid x:Name="rootGrid">
    <Grid Margin="10,10,10,8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*" MinHeight="150"/>
            <RowDefinition Height="10"/>
            <RowDefinition Height="*" MinHeight="180"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="BIMPULSE:LOGO" Height="32" Margin="0,0,9,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <StackPanel VerticalAlignment="Center" MaxWidth="230">
                        <TextBlock Style="{StaticResource Label}" Text="BIMPULSE · ISSUES"/>
                        <TextBlock x:Name="txtProject" Text="BIMPulse Dashboard" FontSize="14" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="btnAccount" Style="{StaticResource Ghost}" Padding="4,3" Margin="0,0,4,0">
                        <StackPanel Orientation="Horizontal">
                            <Border x:Name="bdAvatar" Width="24" Height="24" CornerRadius="12" Background="#14304D">
                                <TextBlock x:Name="txtAvatar" Text="?" FontWeight="Bold" Foreground="#00A0E3"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock x:Name="txtAccount" Text="Sign in" Visibility="Collapsed"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="btnCommand" Style="{StaticResource Ghost}" Content="" Padding="8,1" Margin="0,0,4,0"
                            ToolTip="Find any issue, project or action (Ctrl+K)"/>
                    <Button x:Name="btnMenu" Style="{StaticResource Ghost}" Content="&#x22EF;" FontSize="15" Padding="8,1"
                            ToolTip="Theme, full window, error reports, updates and the tour"/>
                </StackPanel>
            </Grid>
            <WrapPanel Margin="0,8,0,0">
                <Button x:Name="btnBrowse" Style="{StaticResource Primary}" Content="Browse BIMPulse" Margin="0,0,6,4" Padding="10,5"
                        ToolTip="Open your projects' saved audits from BIMPulse"/>
                <Button x:Name="btnReload" Content="Reload" Margin="0,0,6,4" Padding="10,5" ToolTip="Fetch the latest issues and statuses"/>
                <Button x:Name="btnCheck" Content="Check model" Margin="0,0,6,4" Padding="10,5"
                        ToolTip="Look up every issue's elements in this model (and its links)"/>
            </WrapPanel>
        </StackPanel>

        <!-- A new version of the plugin -->
        <Border x:Name="bdUpdate" Grid.Row="1" Margin="0,0,0,8" Padding="10,8" CornerRadius="8" Background="#14304D"
                BorderBrush="#00A0E3" BorderThickness="1" Visibility="Collapsed">
            <StackPanel>
                <TextBlock x:Name="txtUpdate" TextWrapping="Wrap" Text="A new version of the BIMPulse tools for Revit is available."/>
                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                    <Button x:Name="btnUpdateNow" Style="{StaticResource Primary}" Content="Update now" Padding="10,4" Margin="0,0,6,0"/>
                    <Button x:Name="btnUpdateLater" Style="{StaticResource Ghost}" Content="Later" Padding="8,4"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Overview -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="12,9" Margin="0,0,0,8">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel ToolTip="{Binding Text, ElementName=statFiles}">
                        <TextBlock Style="{StaticResource Label}" Text="ISSUES"/>
                        <TextBlock x:Name="statTotal" Text="0" FontSize="17" FontWeight="Bold"/>
                        <TextBlock x:Name="statFiles" Text="No results open" Visibility="Collapsed"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" ToolTip="{Binding Text, ElementName=statCritical}">
                        <TextBlock Style="{StaticResource Label}" Text="OPEN"/>
                        <TextBlock x:Name="statOpen" Text="0" FontSize="17" FontWeight="Bold" Foreground="#F59E0B"/>
                        <TextBlock x:Name="statCritical" Text="" Visibility="Collapsed"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <Grid x:Name="gridRing" Width="34" Height="34" HorizontalAlignment="Left" Visibility="Collapsed"/>
                        <TextBlock Style="{StaticResource Label}" Text="RESOLVED"/>
                        <TextBlock x:Name="statResolved" Text="0%" FontSize="17" FontWeight="Bold" Foreground="#22C55E"/>
                        <TextBlock x:Name="txtScore" Visibility="Collapsed"/>
                        <Grid Height="4" Margin="0,3,10,0">
                            <Border Background="#16243A" CornerRadius="2"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition x:Name="colResolved" Width="0*"/>
                                    <ColumnDefinition x:Name="colUnresolved" Width="1*"/>
                                </Grid.ColumnDefinitions>
                                <Border Background="#22C55E" CornerRadius="2"/>
                            </Grid>
                        </Grid>
                    </StackPanel>
                    <StackPanel Grid.Column="3" ToolTip="{Binding Text, ElementName=statFoundSub}">
                        <TextBlock Style="{StaticResource Label}" Text="IN MODEL"/>
                        <TextBlock x:Name="statFound" Text="–" FontSize="17" FontWeight="Bold" Foreground="#00A0E3"/>
                        <TextBlock x:Name="statFoundSub" Text="Run Check model" Visibility="Collapsed"/>
                    </StackPanel>
                </Grid>
                <Grid x:Name="gridSeverity" Height="6" Margin="0,8,0,4"/>
                <StackPanel x:Name="spSeverityKey" Orientation="Horizontal" Margin="-10,0,0,6"/>
                <WrapPanel x:Name="wpAudits" ToolTip="Click an audit to show only its issues"/>
                <WrapPanel x:Name="spChanged" Visibility="Collapsed" Margin="0,2,0,0"/>
            </StackPanel>
        </Border>

        <!-- Issue list -->
        <Border x:Name="cardList" Grid.Row="3" Style="{StaticResource Card}" Padding="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBox x:Name="tbSearch" ToolTip="Search titles, fields, families, types, element ids"/>
                <TextBlock x:Name="tbSearchHint" Text="Search issues, element ids…" Foreground="#5D6F88"
                           IsHitTestVisible="False" Margin="10,0,0,0" VerticalAlignment="Center"/>
                <Grid Grid.Row="1" Margin="0,6,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="6"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <ComboBox x:Name="cbConsultant"/>
                    <ComboBox x:Name="cbSeverity" Grid.Column="2"/>
                </Grid>
                <Grid Grid.Row="2" Margin="0,6,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="6"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <ComboBox x:Name="cbReview"/>
                    <ComboBox x:Name="cbSort" Grid.Column="2"/>
                </Grid>
                <Grid Grid.Row="3">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Margin="0,0,0,6">
                        <TextBlock x:Name="txtCount" Style="{StaticResource Label}" Text="0 ISSUES"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <TextBlock x:Name="btnSelection" Text="For selection" Foreground="#00A0E3" FontSize="11.5" Cursor="Hand"
                                   Margin="0,0,14,0" ToolTip="Show only the issues of the elements selected in Revit (E)"/>
                            <TextBlock x:Name="btnClearFilters" Text="Clear filters" Foreground="#00A0E3" FontSize="11.5" Cursor="Hand"/>
                        </StackPanel>
                    </Grid>
                    <ListBox x:Name="lbIssues" Grid.Row="1" Background="Transparent" BorderThickness="0" SelectionMode="Extended"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingStackPanel.IsVirtualizing="True"
                             VirtualizingStackPanel.VirtualizationMode="Recycling"/>
                    <StackPanel x:Name="spLoading" Grid.Row="1" Visibility="Collapsed"/>
                    <StackPanel x:Name="pnlNoFiles" Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="12" MaxWidth="320">
                        <Border Width="48" Height="48" CornerRadius="24" Background="#14304D" HorizontalAlignment="Center">
                            <TextBlock x:Name="pnlNoFilesIcon" Text="&#xE838;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="19" Foreground="#00A0E3"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock x:Name="pnlNoFilesTitle" Text="No issues open yet" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,14,0,0"
                                   TextAlignment="Center" TextWrapping="Wrap"/>
                        <TextBlock x:Name="pnlNoFilesBody" Text="Open a saved audit from BIMPulse to see its issues here." Foreground="#8A9BB3" Margin="0,6,0,0" TextWrapping="Wrap" TextAlignment="Center"
                                   LineHeight="19"/>
                        <Button x:Name="pnlNoFilesAction" Style="{StaticResource Primary}" Content="Browse BIMPulse" HorizontalAlignment="Center" Margin="0,14,0,0" Padding="14,6"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <GridSplitter Grid.Row="4" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" ResizeDirection="Rows"
                      Cursor="SizeNS" ToolTip="Drag to resize"/>

        <!-- Detail -->
        <Border x:Name="cardDetail" Grid.Row="5" Style="{StaticResource Card}">
            <Grid>
<ScrollViewer x:Name="pnlWins" VerticalScrollBarVisibility="Auto" Visibility="Collapsed" Padding="14,12,10,8">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Label}" Text="BIGGEST WINS &#xB7; FIX THESE FIRST"/>
                        <TextBlock x:Name="txtWinsSub" Foreground="#8A9BB3" FontSize="11.5" Margin="0,4,0,10" TextWrapping="Wrap"
                                   Text="The few changes that clear the most open issues. Click one to start."/>
                        <StackPanel x:Name="spWins"/>
                        <TextBlock Foreground="#5D6F88" FontSize="11.5" Margin="0,10,0,0" TextWrapping="Wrap"
                                   Text="Or pick any issue in the list. Ctrl+K finds anything."/>
                    </StackPanel>
                </ScrollViewer>
                <StackPanel x:Name="pnlEmpty" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="12" MaxWidth="320">
                    <Border Width="48" Height="48" CornerRadius="24" Background="#14304D" HorizontalAlignment="Center">
                        <TextBlock x:Name="pnlEmptyIcon" Text="&#xE8FD;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="19" Foreground="#00A0E3"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock x:Name="pnlEmptyTitle" Text="Select an issue" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,14,0,0"
                               TextAlignment="Center" TextWrapping="Wrap"/>
                    <TextBlock x:Name="pnlEmptyBody" Text="Its details, fixes and conversation show here. Press Ctrl+K to find anything." Foreground="#8A9BB3" Margin="0,6,0,0" TextWrapping="Wrap" TextAlignment="Center"
                               LineHeight="19"/>
                </StackPanel>
                <Grid x:Name="pnlDetail" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="14,12,10,8">
                        <StackPanel>
                            <WrapPanel>
                                <Border x:Name="bdSeverity" CornerRadius="10" Padding="8,2" Margin="0,0,6,4">
                                    <TextBlock x:Name="txtSeverity" FontFamily="{StaticResource Mono}" FontSize="10" FontWeight="Bold"/>
                                </Border>
                                <Border x:Name="bdReview" CornerRadius="10" Padding="8,2" Margin="0,0,6,4">
                                    <TextBlock x:Name="txtReview" FontFamily="{StaticResource Mono}" FontSize="10" FontWeight="Bold"/>
                                </Border>
                                <TextBlock x:Name="txtMeta" Style="{StaticResource Label}" VerticalAlignment="Center" Margin="2,0,0,4"
                                           TextTrimming="CharacterEllipsis"/>
                            </WrapPanel>
                            <TextBlock x:Name="txtTitle" FontSize="15" FontWeight="Bold" TextWrapping="Wrap" Margin="0,6,0,0"/>
                            <TextBlock x:Name="txtSub" Foreground="#8A9BB3" TextWrapping="Wrap" Margin="0,3,0,0"/>
                            <TextBlock x:Name="txtDescription" TextWrapping="Wrap" Margin="0,10,0,0" Foreground="#C9D6E6"/>

                            <TextBlock Style="{StaticResource Label}" Text="WHAT FAILED" Margin="0,12,0,0"/>
                            <StackPanel x:Name="spFailures" Margin="0,6,0,0"/>
                            <Border x:Name="pnlFix" Margin="0,10,0,0" Visibility="Collapsed" BorderBrush="#00A0E3"
                                    BorderThickness="3,0,0,0" Padding="10,2,0,2">
                                <StackPanel>
                                    <TextBlock Text="Fix it in the model" Foreground="#00A0E3" FontSize="14" FontWeight="Bold"/>
                                    <TextBlock Foreground="#8A9BB3" FontSize="11.5" TextWrapping="Wrap" Margin="0,3,0,8"
                                               Text="Sets the value on this issue's elements in the open model (one undoable change)."/>
                                    <StackPanel x:Name="spFix"/>
                                </StackPanel>
                            </Border>
                            <Border x:Name="bdSnapshot" CornerRadius="8" BorderBrush="#1C2B40" BorderThickness="1" Margin="0,10,0,0"
                                    Background="#081221" Height="160" ClipToBounds="True" Visibility="Collapsed" Cursor="Hand"
                                    ToolTip="Click to open full size">
                                <Image x:Name="imgSnapshot" Stretch="UniformToFill"/>
                            </Border>

                            <Grid Margin="0,14,0,6">
                                <TextBlock x:Name="txtElementsLabel" Style="{StaticResource Label}" Text="ELEMENTS"/>
                                <TextBlock x:Name="txtModelCheck" FontSize="11" HorizontalAlignment="Right"/>
                            </Grid>
                            <StackPanel x:Name="spElements"/>

                            <StackPanel x:Name="pnlComments" Margin="0,12,0,0" Visibility="Collapsed">
                                <TextBlock Style="{StaticResource Label}" Text="COMMENTS IN THE BCF"/>
                                <StackPanel x:Name="spComments" Margin="0,6,0,0"/>
                            </StackPanel>

                            <StackPanel x:Name="pnlAssign" Margin="0,12,0,0" Visibility="Collapsed">
                                <TextBlock Style="{StaticResource Label}" Text="ASSIGNED TO"/>
                                <ComboBox x:Name="cbAssignee" Margin="0,6,0,0" ToolTip="Who should fix it"/>
                                <Grid Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <DatePicker x:Name="dpDue" ToolTip="Due date" SelectedDateFormat="Short"/>
                                    <Button x:Name="btnAssign" Grid.Column="1" Content="Save" Margin="6,0,0,0" Padding="12,4"/>
                                </Grid>
                                <TextBlock x:Name="txtAssign" Foreground="#8A9BB3" FontSize="11.5" Margin="0,5,0,0" TextWrapping="Wrap"/>
                            </StackPanel>

                            <StackPanel x:Name="pnlThread" Margin="0,12,0,0" Visibility="Collapsed">
                                <Grid>
                                    <TextBlock Style="{StaticResource Label}" Text="CONVERSATION · LIVE"/>
                                    <TextBlock x:Name="txtThreadState" Foreground="#5D6F88" FontSize="11" HorizontalAlignment="Right"/>
                                </Grid>
                                <StackPanel x:Name="spThread" Margin="0,6,0,0"/>
                            </StackPanel>

                            <TextBlock x:Name="lblNote" Style="{StaticResource Label}" Text="YOUR NOTE" Margin="0,12,0,6"/>
                            <TextBox x:Name="tbNote" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="50" MaxHeight="110"
                                     VerticalScrollBarVisibility="Auto"/>
                            <Grid Margin="0,6,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <CheckBox x:Name="chkSnapshot" Content="Attach this view" VerticalAlignment="Center" Visibility="Collapsed"
                                          ToolTip="Send a picture of the active Revit view and the view itself, so anyone can go straight back to it"/>
                                <Button x:Name="btnSend" Grid.Column="1" Style="{StaticResource Primary}" Content="Send" Padding="14,4"
                                        Visibility="Collapsed" ToolTip="Send to BIMPulse (Ctrl+Enter)"/>
                            </Grid>
                            <TextBlock x:Name="txtReviewedBy" Foreground="#5D6F88" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0"/>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Actions -->
                    <Border Grid.Row="1" BorderBrush="#1C2B40" BorderThickness="0,1,0,0" Padding="10,8">
                        <StackPanel>
                            <WrapPanel>
                                <Button x:Name="btnZoom" Style="{StaticResource Primary}" Content="Select &amp; zoom" Margin="0,0,6,6" Padding="10,5"/>
                                <Button x:Name="btn3D" Content="3D" Margin="0,0,6,6" Padding="10,5"
                                        ToolTip="Opens the 'BIMPulse Issues 3D' view with a section box around the elements"/>
                                <Button x:Name="btnIsolate" Content="Isolate" Margin="0,0,6,6" Padding="10,5" ToolTip="Temporarily isolate in the active view"/>
                                <Button x:Name="btnSelect" Content="Select" Margin="0,0,6,6" Padding="10,5"/>
                                <Button x:Name="btnProps" Content="Copy ids" Margin="0,0,6,6" Padding="10,5" ToolTip="Copy the element ids to the clipboard"/>
                            </WrapPanel>
                            <WrapPanel>
                                <Button x:Name="btnResolve" Content="Resolve" Margin="0,0,6,6" Padding="10,5" Foreground="#22C55E"/>
                                <Button x:Name="btnIgnore" Content="Ignore" Margin="0,0,6,6" Padding="10,5"/>
                                <Button x:Name="btnReopen" Content="Reopen" Margin="0,0,6,6" Padding="10,5"/>
                                <Button x:Name="btnPrev" Style="{StaticResource Ghost}" Content="‹" Margin="0,0,4,6" Padding="10,5" ToolTip="Previous issue (Ctrl+Up)"/>
                                <Button x:Name="btnNext" Style="{StaticResource Ghost}" Content="›" Margin="0,0,0,6" Padding="10,5" ToolTip="Next issue (Ctrl+Down)"/>
                            </WrapPanel>
                            <CheckBox x:Name="chkAuto" Content="Zoom as I browse" IsChecked="False"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Border>

<!-- Start screen: recent projects (before any result is open) -->
        <Grid x:Name="pnlStart" Grid.Row="2" Grid.RowSpan="4" Background="#050B14" Visibility="Collapsed" Margin="-4,0,-4,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="4,12,4,4" MaxWidth="980">
                    <TextBlock Style="{StaticResource Label}" Text="BIMPULSE DASHBOARD"/>
                    <TextBlock x:Name="txtStartTitle" Text="Welcome back" FontSize="19" FontWeight="Bold" Margin="0,4,0,0"
                               TextWrapping="Wrap"/>
                    <TextBlock x:Name="txtStartBody" Foreground="#8A9BB3" Margin="0,6,0,18" TextWrapping="Wrap"
                               Text="Pick up where you left off, or open another saved audit."/>
                    <TextBlock x:Name="lblRecent" Style="{StaticResource Label}" Text="RECENT" Margin="0,0,0,8"/>
                    <WrapPanel x:Name="wpRecent"/>
                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                        <Button x:Name="btnStartBrowse" Style="{StaticResource Primary}" Content="Browse all projects" Margin="0,0,8,0"/>
                        <Button x:Name="btnStartSignIn" Content="Sign in" Visibility="Collapsed"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- BIMPulse browser (over the dashboard) -->
        <Grid x:Name="pnlBrowse" Grid.Row="2" Grid.RowSpan="4" Background="#050B14" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Border Style="{StaticResource Card}" Padding="10" Margin="0,0,0,8">
                <StackPanel>
                    <Grid Margin="0,0,0,8">
                        <TextBlock Style="{StaticResource Label}" Text="YOUR PROJECTS" VerticalAlignment="Center"/>
                        <TextBlock x:Name="txtOrg" Foreground="#8A9BB3" FontSize="11" HorizontalAlignment="Right"
                                   TextTrimming="CharacterEllipsis" MaxWidth="180"/>
                    </Grid>
                    <Grid Margin="0,0,0,8">
                        <TextBox x:Name="tbProjectSearch"/>
                        <TextBlock x:Name="tbProjectHint" Text="Search projects…" Foreground="#5D6F88" IsHitTestVisible="False"
                                   Margin="10,0,0,0" VerticalAlignment="Center"/>
                    </Grid>
                    <ListBox x:Name="lbProjects" MaxHeight="200" Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
                </StackPanel>
            </Border>
            <Border Grid.Row="1" Style="{StaticResource Card}" Padding="12,10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock Style="{StaticResource Label}" Text="SAVED AUDIT"/>
                        <TextBlock x:Name="txtBrowseProject" Text="Choose a project" FontSize="15" FontWeight="Bold" Margin="0,2,0,6"
                                   TextTrimming="CharacterEllipsis"/>
                        <ComboBox x:Name="cbRevision"/>
                    </StackPanel>
                    <Grid Grid.Row="1" Margin="0,12,0,6">
                        <TextBlock Style="{StaticResource Label}" Text="RESULTS"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <TextBlock x:Name="btnSelectAll" Text="All" Foreground="#00A0E3" FontSize="11.5" Cursor="Hand" Margin="0,0,12,0"/>
                            <TextBlock x:Name="btnSelectNone" Text="None" Foreground="#00A0E3" FontSize="11.5" Cursor="Hand"/>
                        </StackPanel>
                    </Grid>
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="spResults"/>
                    </ScrollViewer>
                </Grid>
            </Border>
            <StackPanel Grid.Row="2" Margin="0,8,0,0">
                <TextBlock x:Name="txtBrowseNote" Foreground="#8A9BB3" FontSize="11.5" TextWrapping="Wrap" Margin="0,0,0,6"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="btnBrowseClose" Content="Back" Margin="0,0,6,0" Padding="12,5"/>
                    <Button x:Name="btnBrowseOpen" Style="{StaticResource Primary}" Content="Open issues" Padding="12,5"/>
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- Status bar -->
        <StackPanel Grid.Row="6" Margin="2,8,2,0">
            <TextBlock x:Name="txtStatus" Foreground="#8A9BB3" FontSize="11" TextWrapping="Wrap" MaxHeight="44"
                       TextTrimming="CharacterEllipsis"/>
            <WrapPanel Margin="0,4,0,0">
                <Button x:Name="btnUndoFix" Content="Undo fix" Margin="0,0,6,0" Padding="8,4" Visibility="Collapsed" Foreground="#F59E0B"/>
                <Button x:Name="btnColour" Style="{StaticResource Ghost}" Content="Colour issues" Margin="0,0,6,0" Padding="8,4"
                        ToolTip="Colour every open issue's elements in the active view by severity"/>
                <Button x:Name="btnClear" Style="{StaticResource Ghost}" Content="Clear colours" Padding="8,4"
                        ToolTip="Clear the colours and any isolation in the active view"/>
            </WrapPanel>
        </StackPanel>
    </Grid>


    <!-- Command bar (Ctrl+K): find any issue, project or action -->
    <Grid x:Name="pnlCommand" Visibility="Collapsed">
        <Border x:Name="bdCommandDim" Background="#99020610"/>
        <Border x:Name="bdCommand" Style="{StaticResource Card}" MaxWidth="580" HorizontalAlignment="Stretch" VerticalAlignment="Top"
                Margin="16,64,16,16" Padding="10" BorderBrush="#00A0E3">
            <StackPanel>
                <Grid>
                    <TextBlock Text="&#xE721;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="14" Foreground="#8A9BB3" VerticalAlignment="Center"
                               Margin="10,0,0,0" IsHitTestVisible="False" Panel.ZIndex="1"/>
                    <TextBox x:Name="tbCommand" FontSize="14" Padding="24,0,0,0"/>
                    <TextBlock x:Name="tbCommandHint" Text="Search issues, projects and actions…" Foreground="#5D6F88" FontSize="14"
                               IsHitTestVisible="False" Margin="42,0,0,0" VerticalAlignment="Center"/>
                </Grid>
                <ListBox x:Name="lbCommand" MaxHeight="400" Margin="0,8,0,0" Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
                <TextBlock Style="{StaticResource Label}" Margin="4,6,0,0" Text="&#x2191;&#x2193; MOVE  &#xB7;  ENTER RUN  &#xB7;  ESC CLOSE"/>
            </StackPanel>
        </Border>
    </Grid>

    <!-- First-run tour -->
    <Grid x:Name="pnlTour" Visibility="Collapsed">
        <Path x:Name="pathTourDim" Fill="#B3020610"/>
        <Border x:Name="bdTourRing" BorderBrush="#00A0E3" BorderThickness="2" CornerRadius="10" HorizontalAlignment="Left"
                VerticalAlignment="Top" IsHitTestVisible="False"/>
        <Border x:Name="bdTourCard" Style="{StaticResource Card}" Width="280" Padding="14,12" HorizontalAlignment="Left"
                VerticalAlignment="Top" BorderBrush="#00A0E3">
            <StackPanel>
                <TextBlock x:Name="txtTourStep" Style="{StaticResource Label}" Text="1 OF 6"/>
                <TextBlock x:Name="txtTourTitle" FontSize="15" FontWeight="Bold" Margin="0,4,0,0" TextWrapping="Wrap"/>
                <TextBlock x:Name="txtTourBody" Foreground="#C9D6E6" Margin="0,6,0,0" TextWrapping="Wrap"/>
                <Grid Margin="0,12,0,0">
                    <Button x:Name="btnTourSkip" Style="{StaticResource Ghost}" Content="Skip" HorizontalAlignment="Left"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="btnTourBack" Content="Back" Margin="0,0,6,0" Padding="10,4"/>
                        <Button x:Name="btnTourNext" Style="{StaticResource Primary}" Content="Next" Padding="12,4"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
    </Grid>
</Page>
